{
  "compilerOptions": {
    /* Language / environment */
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Modules (Vite / bundler mode — types only, no emit) */
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,

    /* Type-checking */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* `vite/client` provides import.meta.env + CSS/asset module declarations.
       Listing it explicitly also keeps Node globals out of the browser code. */
    "types": ["vite/client"]
  },
  "include": ["src"]
}
